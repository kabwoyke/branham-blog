# Production template for Hostinger shared hosting. Copy to .env on the server (never commit .env).
APP_NAME="Branham Samwel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://branhamsamwel.com

# Folder served by the domain. Find it in hPanel > File Manager (usually .../domains/branhamsamwel.com/public_html)
PUBLIC_PATH=/home/uXXXXXXXXX/domains/branhamsamwel.com/public_html

# Scheduled publish times are entered in East Africa Time
APP_PUBLISHING_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Create the database in hPanel > Databases > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXXX_blog
DB_USERNAME=uXXXXXXXXX_blog
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# Newsletter emails wait in the database and are sent by the queue cron job (see README),
# so sending to many subscribers never times out a page.
QUEUE_CONNECTION=database

# Sender of every email: subscriber confirmations, newsletters and contact notifications.
# Create this mailbox in hPanel > Emails > Email Accounts and use its password below.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=newsletter@branhamsamwel.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=newsletter@branhamsamwel.com
MAIL_FROM_NAME="${APP_NAME}"

# Used once by `php artisan db:seed`; delete ADMIN_PASSWORD afterwards
ADMIN_NAME="Branham Samwel"
ADMIN_EMAIL=
ADMIN_PASSWORD=
