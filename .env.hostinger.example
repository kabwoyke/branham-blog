# Production template for Hostinger shared hosting. Copy to .env on the server (never commit .env).
APP_NAME="Branham Samwel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Folder served by the domain. Find it in hPanel > File Manager (usually .../domains/your-domain.com/public_html)
PUBLIC_PATH=/home/uXXXXXXXXX/domains/your-domain.com/public_html

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Create the database in hPanel > Databases > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXXX_blog
DB_USERNAME=uXXXXXXXXX_blog
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# No background worker on shared hosting, so send mail immediately
QUEUE_CONNECTION=sync

# Create the mailbox in hPanel > Emails, then use its credentials
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=hello@your-domain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Used once by `php artisan db:seed`; delete ADMIN_PASSWORD afterwards
ADMIN_NAME="Branham Samwel"
ADMIN_EMAIL=
ADMIN_PASSWORD=
